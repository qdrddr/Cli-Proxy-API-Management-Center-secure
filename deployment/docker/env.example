# Optional CLIProxyAPI storage backends (see https://help.router-for.me/configuration/storage/).
# Copy to .env beside docker-compose.yml and uncomment as needed.
# Local mirror roots default to /CLIProxyAPI/data (writable under nono; persisted in cli-proxy-api-data volume).

# GITSTORE_GIT_URL=https://github.com/you/your-config-repo.git
# GITSTORE_GIT_USERNAME=
# GITSTORE_GIT_TOKEN=
# GITSTORE_GIT_BRANCH=
# GITSTORE_LOCAL_PATH=/CLIProxyAPI/data

# PGSTORE_DSN=postgresql://user:pass@postgres:5432/cliproxy
# PGSTORE_SCHEMA=public
# PGSTORE_LOCAL_PATH=/CLIProxyAPI/data

# OBJECTSTORE_ENDPOINT=https://s3.amazonaws.com
# OBJECTSTORE_BUCKET=your-bucket
# OBJECTSTORE_ACCESS_KEY=
# OBJECTSTORE_SECRET_KEY=
# OBJECTSTORE_LOCAL_PATH=/CLIProxyAPI/data

# For private Git hosts, S3 endpoints, or managed Postgres hostnames, extend nono egress, e.g.:
# NONO_RUN_ARGS=--allow-domain your.db.host --allow-domain s3.your-region.amazonaws.com
